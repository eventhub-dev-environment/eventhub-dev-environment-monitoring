# MongoDB Credentials
MONGO_ROOT_USER=changeme
MONGO_ROOT_PASS=changeme

# RabbitMQ Credentials (use dedicated credentials outside local development)
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Microservices Shared Security
GATEWAY_INTERNAL_SECRET=changeme
JWT_SECRET=changeme

# Stripe Checkout (payment-service)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CHECKOUT_SUCCESS_URL=
PAYMENT_CHECKOUT_CANCEL_URL=
PAYMENT_WEBHOOK_HMAC_SECRET=

# Zipkin / Observability
ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans

# Neon PostgreSQL
NEON_DB_USER=changeme
NEON_DB_PASS=changeme
NEON_DB_AUTH_URL=jdbc:postgresql://<neon-host>/<auth-database>?sslmode=require
NEON_DB_BOOKING_URL=jdbc:postgresql://<neon-host>/<booking-database>?sslmode=require
NEON_DB_PAYMENT_URL=jdbc:postgresql://<neon-host>/<payment-database>?sslmode=require

# SMTP (notification-service)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=changeme
MAIL_PASSWORD=changeme

# AWS S3 (branding assets)
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
